#!/usr/bin/env bash
# pre-push: the full local gate, mirroring what CI would burn minutes
# on — fmt, clippy across every feature combo the workflows build, and
# the fast test suites. Runs ONCE per push, not per commit. Install
# once: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null; then
    echo "pre-push: cargo not found — skipping" >&2
    exit 0
fi

cargo fmt --all -- --check

# every combo CI compiles (keep in sync with .github/workflows/ci.yml)
COMBOS=(
    ""                     # default
    "cloud"
    "system,cloud"
    "sherpaonnx"
    "cloud,sherpaonnx"
    "cloud,sherpaonnx,sherpa-g2p"
    "sherpa-g2p"           # not in CI, but a regression here bit us once
    "cloning"
    "floravox"
    "pocket-timing"
)
fail=0
for combo in "${COMBOS[@]}"; do
    if [ -z "$combo" ]; then
        args=""
        label="(default)"
    else
        args="--no-default-features --features $combo"
        label="$combo"
    fi
    if ! cargo clippy $args --all-targets -- -D warnings >/dev/null 2>&1; then
        echo "pre-push: clippy FAILED for [$label]" >&2
        fail=1
    fi
done
[ "$fail" -eq 0 ] || { echo "pre-push: fix clippy before pushing (CI would fail the same way)" >&2; exit 1; }

# fast suites (the lib suites; live/ignored tests stay opt-in)
cargo test --lib --quiet >/dev/null || { echo "pre-push: default test suite failed" >&2; exit 1; }
cargo test --no-default-features --features cloud,sherpaonnx,sherpa-g2p --lib --quiet >/dev/null \
    || { echo "pre-push: sherpa-g2p test suite failed" >&2; exit 1; }

exit 0
