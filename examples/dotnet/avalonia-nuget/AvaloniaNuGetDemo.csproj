<Project Sdk="Microsoft.NET.Sdk">

  <!-- GH #71: minimal Avalonia app consuming the RELEASED
       RustTtsWrapper.Bindings NuGet package (engine selection, voice
       discovery, preview, stop) — a tested starting point for .NET
       desktop apps migrating from DotNetTtsWrapper.AbstractTtsClient.

       Two modes:
         default           — NuGet package (matches end-user experience;
                             native assets resolve from runtimes/win-x64)
         UseLocalBindings  — ProjectReference to the in-repo bindings, to
                             try unreleased APIs (typed setup schema, etc.)
                             against a locally built native library. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release pin: bump when a new RustTtsWrapper.Bindings ships.
       1.6.6 ships win-x64/win-x86 native assets (SAPI, cloud,
       sherpa-onnx, qwen3-local, omnivoice-local, pocket). -->
  <PropertyGroup>
    <RustTtsWrapperVersion>1.6.6</RustTtsWrapperVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalBindings)' != 'true'">
    <PackageReference Include="RustTtsWrapper.Bindings" Version="$(RustTtsWrapperVersion)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseLocalBindings)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_LOCAL_BINDINGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalBindings)' == 'true'">
    <ProjectReference Include="../../../bindings/dotnet/RustTtsWrapper.Bindings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
  </ItemGroup>

</Project>
