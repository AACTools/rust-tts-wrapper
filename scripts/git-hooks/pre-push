#!/usr/bin/env bash
# pre-push: the full local gate, mirroring what CI would burn minutes
# on — fmt, clippy across every feature combo the workflows build, and
# the fast test suites. Runs ONCE per push, not per commit. Install
# once: git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null; then
    echo "pre-push: cargo not found — skipping" >&2
    exit 0
fi

cargo fmt --all -- --check

# every combo CI compiles (keep in sync with .github/workflows/ci.yml)
COMBOS=(
    ""                     # default
    "cloud"
    "system,cloud"
    "sherpaonnx"
    "cloud,sherpaonnx"
    "cloud,sherpaonnx,sherpa-g2p"
    "sherpa-g2p"           # not in CI, but a regression here bit us once
    "sherpaonnx,speaker"   # #139 cpal playback (needs libasound2-dev locally)
    "cloning"
    "floravox"
    "pocket-timing"
    "omnivoice-local"     # #151: links the dev stub (scripts/dev-stubs)
                          # so the combo runs without a locally built
                          # runtime — CI builds the real one; catching
                          # clippy/test failures here saves the run
)
fail=0
for combo in "${COMBOS[@]}"; do
    if [ -z "$combo" ]; then
        args=""
        label="(default)"
    else
        args="--no-default-features --features $combo"
        label="$combo"
    fi
    # The omnivoice-local combo needs OMNIVOICE_LIB at build time; the
    # dev stub satisfies it without a real runtime build.
    if [[ "$combo" == "omnivoice-local" ]]; then
        export OMNIVOICE_LIB="$PWD/scripts/dev-stubs"
    fi
    if ! cargo clippy $args --all-targets -- -D warnings >/dev/null 2>&1; then
        echo "pre-push: clippy FAILED for [$label]" >&2
        fail=1
    fi
done
[ "$fail" -eq 0 ] || { echo "pre-push: fix clippy before pushing (CI would fail the same way)" >&2; exit 1; }

# vendored Swift header must match include/tts_wrapper.h (the
# bindings.yml Swift job enforces this in CI — catch it here first;
# a #111 push burned a run on exactly this drift)
if ! diff -q include/tts_wrapper.h \
        bindings/swift/Sources/CRustTtsWrapper/include/tts_wrapper.h >/dev/null; then
    echo "pre-push: vendored Swift header is stale — run:" 2>&1
    echo "  cp include/tts_wrapper.h bindings/swift/Sources/CRustTtsWrapper/include/tts_wrapper.h" 2>&1
    exit 1
fi

# fast suites (the lib + integration suites; live/ignored tests
# stay opt-in). The integration half earned its place on #127: the
# pronunciation middleware inherited trait DEFAULTS instead of
# delegating (check_credentials_status downgraded Rejected) — every
# lib suite was green and only tests/error_detail_ffi.rs caught it,
# burning a CI run.
cargo test --lib --quiet >/dev/null || { echo "pre-push: default test suite failed" >&2; exit 1; }
cargo test --tests --quiet >/dev/null || { echo "pre-push: default integration suite failed" >&2; exit 1; }
cargo test --no-default-features --features cloud,sherpaonnx,sherpa-g2p --lib --quiet >/dev/null \
    || { echo "pre-push: sherpa-g2p test suite failed" >&2; exit 1; }
cargo test --no-default-features --features cloud,sherpaonnx,sherpa-g2p --tests --quiet >/dev/null \
    || { echo "pre-push: sherpa-g2p integration suite failed" >&2; exit 1; }
# omnivoice-local suite against the dev stub (engine + contract-guard
# tests; live/ignored tests stay opt-in). The TEST_MODEL/CODEC exports
# are load-bearing: without them the engine-level tests silently skip
# (loop-review finding — the guards were inert in every automated gate).
export OMNIVOICE_LIB="$PWD/scripts/dev-stubs"
export OMNIVOICE_TEST_MODEL=/dev/null
export OMNIVOICE_TEST_CODEC=/dev/null
cargo test --no-default-features --features omnivoice-local --lib --quiet >/dev/null \
    || { echo "pre-push: omnivoice-local test suite failed" >&2; exit 1; }
cargo test --no-default-features --features omnivoice-local --tests --quiet >/dev/null \
    || { echo "pre-push: omnivoice-local integration suite failed" >&2; exit 1; }

exit 0
