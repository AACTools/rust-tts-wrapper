# Copy to .env (or tests/live_cloud.env) and fill in after rotating keys.
# NEVER commit real credentials. .env and *.live.env are gitignored.
#
# These are read by tests/live_cloud.rs (run with: cargo test --test live_cloud -- --ignored).

# Google Cloud TTS (one of the two keys)
GOOGLE_TTS_API_KEY=your-google-key

# Microsoft Azure TTS
AZURE_SUBSCRIPTION_KEY=your-azure-key
AZURE_REGION=uksouth

# IBM Watson
WATSON_API_KEY=your-watson-key
WATSON_REGION=eu-gb
WATSON_INSTANCE_ID=your-instance-id

# AWS Polly (currently disabled in code — SigV4 not implemented)
POLLY_REGION=us-east-1
POLLY_AWS_KEY_ID=your-aws-key-id
POLLY_AWS_ACCESS_KEY=your-aws-secret

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional model override. Defaults to eleven_v4 (audio tags: [whispers],
# [shouting]; inline "/IPA/" pronunciation; 90+ languages via the
# `language` credential). Use eleven_v3, eleven_multilingual_v2 or
# eleven_flash_v2_5 for older behaviour (<break> markup, phoneme tags on
# flash_v2, voice_settings.speed).
# ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Optional language selector (v4): 3-letter codes — eng, cmn, fra, deu, …
# ELEVENLABS_LANGUAGE=eng

# Wit.ai
WITAI_TOKEN=your-witai-token

# PlayHT
PLAYHT_API_KEY=your-playht-key
PLAYHT_USER_ID=your-playht-user-id

# OpenAI
OPENAI_API_KEY=your-openai-key

# Cartesia
CARTESIA_API_KEY=your-cartesia-key

# Deepgram
DEEPGRAM_API_KEY=your-deepgram-key

# Fish Audio
FISHAUDIO_API_KEY=your-fishaudio-key

# Hume AI
HUME_API_KEY=your-hume-key

# Mistral
MISTRAL_API_KEY=your-mistral-key

# Murf
MURF_API_KEY=your-murf-key

# Resemble AI
RESEMBLE_API_KEY=your-resemble-key

# Unreal Speech
UNREALSPEECH_API_KEY=your-unrealspeech-key

# UpliftAI
UPLIFTAI_API_KEY=your-upliftai-key

# xAI
XAI_API_KEY=your-xai-key

# ModelsLab
MODELSLAB_API_KEY=your-modelslab-key

# Qwen (Alibaba Cloud Model Studio / DashScope) — used by tests/qwen_live.rs
QWEN_API_KEY=your-dashscope-key
# Optional overrides (see src/cloud_engine/qwen.rs):
# QWEN_MODEL=qwen-audio-3.0-tts-flash
# QWEN_VOICE=longanhuan_v3.6
# QWEN_REGION=qwencloud   # or intl / beijing
# QWEN_INSTRUCTION=Speak cheerfully.
# Voice cloning live test (tests/cloning_live.rs): path to an Apple
# Personal Voice "Recordings" export zip.
# QWEN_PV_ZIP=/path/to/My Personal Voice - Recordings.zip

# Qwen3-TTS local (qwen3-tts.cpp) — used by tests/qwen3_local_live.rs.
# Library must be built first: scripts/build-qwen3-local.sh
# QWEN3_TTS_LIB=/path/to/qwen3-tts.cpp        (build + link)
# QWEN3_TTS_MODELS=/path/to/qwen3-tts.cpp/models
# QWEN3_TTS_REF=/path/to/reference.wav
